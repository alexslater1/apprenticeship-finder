# Copy to .env and fill in. Never commit .env.

# Find an Apprenticeship Display Advert API v2 (https://developer.apprenticeships.education.gov.uk/)
FAA_API_KEY=

# Supabase (scraper uses the secret key; the web app uses only the publishable key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Only needed for `npm run migrate` (direct Postgres connection)
SUPABASE_DB_PASSWORD=

# Web app build (public by design; RLS protects the data)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Email digest (Gmail SMTP + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
DIGEST_TO=you@example.com,him@example.com

# Optional sources (skipped when empty)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
SERPAPI_KEY=
TAVILY_API_KEY=
